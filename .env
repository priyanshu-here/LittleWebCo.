# Public, build-time values. These are embedded in the client bundle by design.

# Web3Forms access key. Web3Forms keys are intended to be public.
VITE_WEB3FORMS_KEY=4907d98b-53f6-407d-bc5f-72a14c190434

# Canonical site URL, e.g. https://www.yourdomain.com
# Leave empty until a domain is connected. On Vercel the production URL is used automatically.
VITE_SITE_URL=
